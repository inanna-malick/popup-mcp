// PEG grammar for popup condition expressions
// Bare identifiers are references; an optional @ prefix is accepted for compatibility.
// String literals may be quoted with " or '.

WHITESPACE = _{ " " | "\t" | "\n" | "\r" }

// Entry point: require the whole input to parse (no silently ignored trailing garbage)
full = { SOI ~ expr ~ EOI }

// Top-level expression
expr = { or }

// Logical OR (lowest precedence)
or = { and ~ ("||" ~ and)* }

// Logical AND
and = { comp ~ ("&&" ~ comp)* }

// Comparison expressions
comp = { value ~ (op ~ value)? }

// Comparison operators
op = { ">=" | "<=" | "==" | "!=" | ">" | "<" }

// Values (ordered by precedence - boolean before ref to catch true/false)
value = {
    "(" ~ expr ~ ")"  // Parenthesized expression
  | "!" ~ value       // Negation
  | boolean           // Boolean literals (before ref to match first)
  | func              // Function call (before ref - needs parens)
  | ref               // Field reference (bare identifier, optional @ prefix)
  | number            // Numeric literal
  | string            // String literal (must be quoted)
}

// Boolean literals (must not be a prefix of a longer identifier)
boolean = @{ ("true" | "false") ~ !(ASCII_ALPHANUMERIC | "_") }

// Field reference (bare identifier, optional legacy @ prefix)
ref = @{ "@"? ~ ident }

// Function call. selected() is special-cased: its second argument is a
// literal option value that may contain spaces without quoting,
// e.g. selected(strategy, Regenerate from sandbox)
func = { selected_func | generic_func }

selected_func = { "selected" ~ "(" ~ ref ~ "," ~ selected_value ~ ")" }
selected_value = { string | bare_value }
bare_value = @{ (!")" ~ ANY)+ }

generic_func = { ident ~ "(" ~ args? ~ ")" }

// Function arguments
args = { expr ~ ("," ~ expr)* }

// Identifier (alphanumeric + underscore, must start with letter or underscore)
ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Number literal (integer or float, optionally negative)
number = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }

// String literal (single or double quoted)
string = @{ "\"" ~ (!("\"") ~ ANY)* ~ "\"" | "'" ~ (!("'") ~ ANY)* ~ "'" }
