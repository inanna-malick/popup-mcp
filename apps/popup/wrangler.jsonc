{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "popup-mcp-app",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/ui",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": { "enabled": true },
}
